# built binaries and object files
*.exe
*.o
*.obj
*.dll
*.so

# the engine as the build scripts name it on Linux and the Pi (no extension)
reva_native/crowd_linux
reva_native/crowd_vk
reva_native/crowd_headless
reva_native/crowd_soft
reva_native/crowd_dev
reva_native/crowd_*_vk
reva_native/crowd_*_h
reva_native/crowd_*_soft

# a packaged game (reva_native/package.py): built, never committed
reva_native/dist/

# baked assets and source models -- large, and reproducible from the tools
*.rpack
*.glb
*.fbx
*.ppm
packs/
packs_*/
props/
*.bak_*
*.bak
*.before_bake
padlog.txt
*.jpg
*.png
*.tga
*.mp4
*.log
build_*.txt

# ⛔ wide glyphs baked from a font (skate_src/author/fontbake.py): the font's licence goes with the file, so one
# is never this repository's, in any game's folder. Nothing ships but the TV font.
*.tvw

# ⛔ bought and downloaded models land in models/ -- .blend, .mhpkg, .zip and other binaries that a
# `git add -A` swept into a commit once. Source assets live on disk, not in git.
models/
*.blend
*.mhpkg

# what the games make for themselves, and what a run leaves behind
reva_native/games/*/cooked/
reva_native/games/*/stage/
reva_native/games/*/open.txt
reva_native/games/*/save/
reva_native/games/roam/props/
reva_native/games/roam/sets/
reva_native/games/roam/packs/
reva_native/save/

# ...and what three of them keep in git: small packs and props built by code. The golden packs and one sprite
# sheet too. talk, people and roam make theirs with games/<name>/make_assets.py, and those stay out.
!reva_native/anim_bench/golden/**/*.rpack
!reva_native/games/sample/packs/
!reva_native/games/sample/packs/*.rpack
!reva_native/games/tower/packs/
!reva_native/games/tower/packs/*.rpack
!reva_native/games/tower/props/
!reva_native/games/tower/props/*.rpack
!reva_native/games/herd/packs/
!reva_native/games/herd/packs/*.rpack
!reva_native/games/herd/props/
!reva_native/games/herd/props/*.rpack
!reva_native/games/rocks/sheet.png

# what the demos and the bench write
reva_native/sets/everything.set
reva_native/sets/everything.trk
reva_native/sets/everything.cams.txt
reva_native/sets/everything_film.set
reva_native/sets/everything_film.trk
reva_native/sets/_trk3_demo.trk
reva_native/sets/_mat_demo.probes
reva_native/sets/_mat_demo.env
reva_native/anim_bench/_shotout/
reva_native/anim_bench/live.json
reva_native/clubcloth/out/

# scene audio: generated by the say_* tools and compile_scene.py (recipes in, artifacts out)
reva_native/scenes/wav/
reva_native/scenes/*.wav
reva_native/scenes/sfx/*.wav
reva_native/scenes/voices/
takes/
films/

# Unreal export staging: copied uassets and intermediate files, rebuilt from the recipes
skate_src/kaeli/CleoExport/
skate_src/kaeli/export/
skate_src/guns/GunExport/
skate_src/guns/export/
skate_src/zombies/export/
skate_src/anima/AnimaExport/Content/
skate_src/anima/AnimaExport/Intermediate/
skate_src/anima/AnimaExport/Saved/
skate_src/anima/AnimaExport/DerivedDataCache/
skate_src/anima/AnimaExport/Binaries/

# Python bytecode, and the tools' default output folder
__pycache__/
*.pyc
out/

# the Godot hand-off: the exported moves and their visual check ARE the deliverable
!godot/animations/*.glb
!godot/*.png
# a character we own and hand over whole (body, texture, moves, board in one .glb). Godot extracts the
# embedded texture beside it on import -- that copy is rebuilt, so it stays out.
!godot/characters/**/*.glb
!godot/characters/**/preview_*.png
godot/characters/**/*.png.import

# Godot: its import cache is rebuilt from the sources; the .import files (loop modes) are kept
godot/.godot/
