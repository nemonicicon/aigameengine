# built binaries and object files
*.exe
*.o
*.obj

# baked assets and source models -- large, and reproducible from the tools
*.rpack
*.glb
*.fbx
*.ppm
packs/
packs_*/
props/
*.bak_*
*.bak
padlog.txt
*.dll
reva_archive/
# linux build outputs (no extension)
reva_native/crowd_kms
reva_native/crowd_bench
reva_native/first_pixel
reva_native/skin_one
reva_native/crowd_linux
*.jpg
*.png

# ...EXCEPT the pixel regression's reference. `*.png` above is meant to keep loose
# screenshots out of the repo and it was quietly eating shotsweep.py's baseline, whose
# own bless message literally ends 'COMMIT IT'. The consequence: _shotref/ existed only
# on this machine, so on a clean checkout the four STRICT shots have nothing to diff
# against and the regression silently degrades to a liveness check.
!reva_native/anim_bench/_shotref/*.png

# UE export staging for character ingest (kaeli): shim project + exports, GB-scale
skate_src/kaeli/CleoExport/
skate_src/kaeli/export/
*.tga
*.log
build_*.txt

# UE export staging: copied uassets + intermediate GLBs, rebuildable from the recipe
skate_src/guns/GunExport/
skate_src/guns/export/
skate_src/guns/*.log
skate_src/mob1/*.glb

# scene audio: generated by scenes/say.ps1 + compile_scene.py (recipes in, artifacts out)
reva_native/scenes/wav/
reva_native/scenes/*.wav
reva_native/scenes/sfx/*.wav   # the foley shelf: synthesised by sfxgen.py / foley.py (recipes in, artifacts out)
reva_native/scenes/voices/

# the sweep's working output; only anim_bench/_shotref is committed
reva_native/anim_bench/_shotout/
skate_src/zombies/export/
skate_src/zombies/*.glb
skate_src/zombies/*.log
takes/
four_hundred_and_six.mp4
reva_native/scenes/voices/kokoro/
four_hundred_and_six_small.mp4

# Python bytecode caches -- three of these were tracked and one was being committed
# with real changes; they are build output of the authoring/film scripts, never source.
__pycache__/
*.pyc

# ⛔ Fab/Marketplace downloads land in models/ -- .blend, .mhpkg, .zip and other
# binaries that `git add -A` swept into a commit once. Source assets live on disk, not
# in git; the tools bake them into packs/, which is already ignored.
models/
*.blend
*.mhpkg

# FOUR HUNDRED AND SIX takes -- tens of MB each, and reproducible from driver.py scene
films/

# the Anima export shim's staged UE assets: 662 MB copied out of the ZAMNRemake project
# so `-run=pythonscript` has a project with PythonScriptPlugin enabled. The RECIPES are
# tracked; the copied uassets are not -- they belong to the source project.
skate_src/anima/AnimaExport/Content/

# recovered texture sets + the map generated from the UE materials (regenerate with
# skate_src/anima/ue_export_textures.py + ue_dump_materials.py)
models/_out/
skate_src/anima/AnimaExport/Intermediate/
skate_src/anima/AnimaExport/Saved/
skate_src/anima/AnimaExport/DerivedDataCache/
skate_src/anima/AnimaExport/Binaries/

# the club's memory between nights -- per machine, never committed
reva_native/save/*.sav
reva_native/save/*.tmp
# written by driver.py up / --live (runtime), and the 2026-09-10 reva rebuild's backups
reva_native/anim_bench/live.json
*.pre0910

# archived history -- pre-git engine backups and the sibling pack dirs (2026-09-11)
reva_native/_archive/

# the kit
__pycache__/
out/

# the Godot hand-off: the exported moves and their visual check ARE the deliverable
!godot/animations/*.glb
!godot/*.png
# a character we own and hand over whole (Clanker: body, texture, moves, board in one .glb). Godot
# extracts the embedded texture beside it on import -- that copy is rebuilt, so it stays out.
!godot/characters/**/*.glb
!godot/characters/**/preview_*.png
godot/characters/**/*.png.import

# Godot: its import cache is rebuilt from the sources; the .import files (loop modes) are kept
godot/.godot/
