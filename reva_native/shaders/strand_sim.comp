        else if (near9 && j >= 2 && mid > 0 && body) { vec3 xa = GET(X, p - 1), xb = x, n9 = vec3(0.0); float dep = 0.0;
            if (segOut(xa, xb, margin, deepIn, stp, mid, j < 3, n9, dep) > 0) { PUT(X, p - 1, xa); PUT(X, p, xb); if (dep > cd) { cd = dep; cn = n9; } } }
        if (cd > 0.0) { vec3 v = GET(Vv, p); float vn = dot(v, cn); vec3 vt = v - cn * vn; float vtl = length(vt), fr = vtl > 1e-9 ? min(fric * cd / (vtl * dt), 1.0) : 0.0;
