    gVD = ivec3(int(PRM[101]), int(PRM[102]), int(PRM[103])); gVS = PRM[104]; gVO = vec3(PRM[105], PRM[106], PRM[107]);
    float dt = settle ? PRM[95] : PRM[67]; u1g = settle ? 1.0 : float(pc.k + 1) / PRM[66]; lerpOn = !settle && PRM[86] > 0.5;
    float sc = PRM[68], gdt = PRM[69] * dt, damp = max(0.0, 1.0 - PRM[70] * dt), margin = PRM[71], idt = 1.0 / dt, aB = PRM[72] * sc / (dt * dt), sk1 = PRM[73], sk2 = PRM[74], fric = PRM[75];
    bool head = PRM[76] > 0.5; int mid = int(PRM[77] + 0.5); bool body = PRM[85] > 0.5; float deepIn = PRM[87], stp = PRM[88];
    float lk = PRM[110] > 0.0 ? PRM[110] : 1.0;   // (11-11) a lock's lengths are the pack's: how long it is in the world, at her size (engine/strands.inc, REVA_STRANDLEN)
    bool field = PRM[111] > 0.5; gFoot = 0.75 * gVS; float most = 2.0 * margin;   // (11-11) her body as a distance with no steps in it (sdfAt, above)
    float shA = PRM[112], shB = PRM[113], holdL = PRM[114], holdW = PRM[115], holdD = PRM[116];      // (11-11) the haircut's own shell, and a hair's own stiffness (below)
    mat4 E = prmMat(32), Ei = prmMat(48);
