    // and less by the cube of how far along the lock it is past that: a short fringe keeps the way it was combed, a long lock hangs
    if (holdL > 0.0) for (int j = 1; j < np; j++) { int p = b + j; float kq = holdL / max(LOCKD[p].y * lk, 1e-6); kq = kq >= 1.0 ? 1.0 : kq * kq * kq;
