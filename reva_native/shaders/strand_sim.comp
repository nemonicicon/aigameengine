    // one pass of constraints: how the lock leaves her scalp, its length, a straight hair's bend, the tether from the root
    for (int j = 1; j <= 2 && j < np; j++) { int p = b + j; vec3 t = mix(GET(T0, p), GET(T1, p), u1g); float md = j == 1 ? sk1 : sk2; vec3 d = GET(X, p) - t; float l2 = dot(d, d);
        if (l2 > md * md) PUT(X, p, t + d * (md / sqrt(l2))); }
