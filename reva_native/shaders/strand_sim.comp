#version 450
// (11-06) ONE SUBSTEP OF EVERY LOCK, a lock to an invocation: engine/strands.inc's hsStepXR line for line (Jolt's way: gravity and damping on the speed, the
// points move, one pass of constraints -- held to the haircut, inextensible, a straight hair's bend, the tether -- the speed rebuilt from where they ended, then
// collisions with her skull, her body and, near her head, the segments, positions only, with friction). mode 1: a frame of the settle, the haircut held still.
#extension GL_GOOGLE_include_directive : enable
layout(local_size_x = 64) in;
#include "strand.glsl"
const uint HS_GRID = 131072u;
uint hsHash(int a, int b, int c) { return ((uint(a) * 73856093u) ^ (uint(b) * 19349663u) ^ (uint(c) * 83492791u)) & (HS_GRID - 1u); }
float u1g; bool lerpOn; float gCell; vec3 gLo, gHi; ivec3 gVD; float gVS; vec3 gVO;   // read once a substep: PRM is in the GPU's memory, but every lookup still costs
// a point of her body this substep: between last frame's place and this one's, as the roots are
vec3 bodyP(int c) { vec4 a = BODY[c * 4], f = BODY[c * 4 + 2]; return (lerpOn && a.w > 0.5) ? mix(a.xyz, f.xyz, u1g) : f.xyz; }
vec3 bodyN(int c) { vec4 f = BODY[c * 4 + 3]; if (lerpOn && BODY[c * 4].w > 0.5) { vec3 n = mix(BODY[c * 4 + 1].xyz, f.xyz, u1g); float l = length(n); return l > 1e-9 ? n / l : f.xyz; } return f.xyz; }
// a point out of her body: the nearest of her within a cell, and out along its normal to the margin. pro: what it found (-1 nothing, 1 part of her head standing out)
float bodyPush(inout vec3 x, float margin, out vec3 nOut, out int pro) {
    pro = -1; nOut = vec3(0.0);
    // (11-06) one read of the closest-point grid (strand_vox.comp), where walking the hash grid's chains had the substeps at 293 ms a frame
    // the 8 cells whose middles surround it, each cell's point measured from the hair itself, the nearest within the reach: one cell's point is the nearest to the
    // cell's middle, and taken alone it flung hairs off her crown (a surface facing another way read a hair outside her as inside)
    ivec3 c = ivec3(floor((x - gVO) / gVS - 0.5)); int best = -1; float bd = gCell * gCell;
    for (int e = 0; e < 8; e++) { ivec3 v = c + ivec3(e & 1, (e >> 1) & 1, e >> 2); if (any(lessThan(v, ivec3(0))) || any(greaterThanEqual(v, gVD))) continue;
        uint key = VOX[(v.z * gVD.y + v.y) * gVD.x + v.x]; if (key == 0xFFFFFFFFu) continue;
        int i = int(key & 0xFFFFu); vec3 d = x - bodyP(i); float d2 = dot(d, d); if (d2 < bd || (d2 == bd && i < best)) { bd = d2; best = i; } }
    if (best < 0) return 0.0;
