    for (int j = 1; j < np; j++) { int p = b + j; float w0 = j == 1 ? 0.0 : 1.0; vec3 xa = GET(X, p - 1), xb = GET(X, p), d = xb - xa; float l = length(d), den = l * (w0 + 1.0);
        if (den < 1e-12) continue; float f = (l - LOCKD[p].x * lk) / den; PUT(X, p - 1, xa + w0 * d * f); PUT(X, p, xb - d * f); }
    for (int j = 0; j + 2 < np; j++) { int p = b + j; float w0 = j == 0 ? 0.0 : 1.0, L = (LOCKD[p + 1].x + LOCKD[p + 2].x) * lk; vec3 xa = GET(X, p), xc = GET(X, p + 2), d = xc - xa;
        float l = length(d), den = l * (w0 + 1.0 + aB); if (den < 1e-12) continue; float f = (l - L) / den; PUT(X, p, xa + w0 * d * f); PUT(X, p + 2, xc - d * f); }
    { vec3 x0 = GET(X, b); for (int j = 2; j < np; j++) { int p = b + j; vec3 d = GET(X, p) - x0; float l2 = dot(d, d), g = LOCKD[p].y * lk; if (l2 > g * g) PUT(X, p, x0 + d * (g / sqrt(l2))); } }
