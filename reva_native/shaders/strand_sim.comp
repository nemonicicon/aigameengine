}
// ⭐ (11-11) HER BODY AS A DISTANCE WITH NO STEPS IN IT (PRM 111; REVA_STRANDFIELD=0 is bodyPush and segOut as they were). Stray hairs at the
// outline wriggled like worms, very fast. Measured on a head standing still, long after settling: 287 of her 7,908 locks had points past 100 mm/s
// and turned back on themselves frame after frame, every one of them a lock lying on her forehead, brows and temples; with her body's surfaces off, 1. bodyPush
// takes the nearest point of her and pushes to that point's own flat plane: where the nearest point changes the plane jumps (most where she curves: a brow, an
// eyelid, an ear), and a point 13 mm to one side of the last point at an edge is pushed by a plane that has nothing to do with it. A substep is 2.8 ms, so a jump
// of a tenth of a millimetre is 36 mm/s once the lengths pull it back. Here each of the eight cells round a hair's point says how far its own middle is from her
// (from the cell's nearest point as a small disc, gFoot across: straight off it, or round its rim; under it, less than nothing), and the eight are blended by
// where the point is among them: one number that changes smoothly as the point moves, and its slope is the way out. The same 287 locks: 1.
float gFoot;
float cellSd(ivec3 v) {
    if (any(lessThan(v, ivec3(0))) || any(greaterThanEqual(v, gVD))) return gCell;
    uint key = VOX[(v.z * gVD.y + v.y) * gVD.x + v.x]; if (key == 0xFFFFFFFFu) return gCell;
    int i = int(key & 0xFFFFu); vec3 r = gVO + (vec3(v) + 0.5) * gVS - bodyP(i); float d = dot(r, bodyN(i)), e = max(sqrt(max(dot(r, r) - d * d, 0.0)) - gFoot, 0.0);
    return d >= 0.0 ? sqrt(d * d + e * e) : e + d;
}
float sdfAt(vec3 x, out vec3 g) {
    vec3 f = (x - gVO) / gVS - 0.5; ivec3 c = ivec3(floor(f)); vec3 t = f - vec3(c);
    float s0 = cellSd(c), s1 = cellSd(c + ivec3(1, 0, 0)), s2 = cellSd(c + ivec3(0, 1, 0)), s3 = cellSd(c + ivec3(1, 1, 0));
    float s4 = cellSd(c + ivec3(0, 0, 1)), s5 = cellSd(c + ivec3(1, 0, 1)), s6 = cellSd(c + ivec3(0, 1, 1)), s7 = cellSd(c + ivec3(1, 1, 1));
    float x00 = mix(s0, s1, t.x), x10 = mix(s2, s3, t.x), x01 = mix(s4, s5, t.x), x11 = mix(s6, s7, t.x), y0 = mix(x00, x10, t.y), y1 = mix(x01, x11, t.y);
    g = vec3(mix(mix(s1 - s0, s3 - s2, t.y), mix(s5 - s4, s7 - s6, t.y), t.z), mix(x10 - x00, x11 - x01, t.z), y1 - y0) / gVS;
    return mix(y0, y1, t.z);
}
// a point out of her, by the distance: up its slope to the margin, no further in a substep than `most`
float sdfPush(inout vec3 x, float margin, float most, out vec3 nOut) {
    vec3 g; nOut = vec3(0.0); float sd = sdfAt(x, g); if (sd >= margin) return 0.0;
    float gl = length(g); if (gl < 0.05) return 0.0;
    float push = min((margin - sd) / max(gl, 0.5), most); nOut = g / gl; x += nOut * push; return push;
}
// a segment kept out of her, by the distance: nothing to do when its middle is further from her than half its length; else looked along every few mm between its
// ends, and what's nearer her than half the margin is lifted to that (an ear between two points both clear of it; a segment lying on her dips a little between
// its ends, and is left alone)
int sdfSeg(inout vec3 a, inout vec3 b, float margin, float stp, float most, inout vec3 nOut, inout float depth) {
    float L = length(b - a); vec3 g; if (sdfAt(0.5 * (a + b), g) > 0.5 * L + margin) return 0;
    int ns = clamp(int(L / stp), 1, 8), hits = 0; float ms = 0.5 * margin;
    for (int m = 1; m <= ns; m++) { float t = float(m) / float(ns + 1); vec3 q = mix(a, b, t), n9; float dp = sdfPush(q, ms, most, n9); if (dp <= 0.0) continue;
        float s9 = dp / ((1.0 - t) * (1.0 - t) + t * t); a += n9 * s9 * (1.0 - t); b += n9 * s9 * t; hits++; if (dp > depth) { depth = dp; nOut = n9; } }
    return hits;
}
// a segment kept out of her (engine/strands.inc's hsSegOut): by an ear every few mm from the first touch, elsewhere at its thirds and only well in
int segOut(inout vec3 a, inout vec3 b, float margin, float deepIn, float stp, int mid, bool proOnly, inout vec3 nOut, inout float depth) {
    vec3 n9; int pro; vec3 probe = 0.5 * (a + b); bodyPush(probe, margin * 4.0, n9, pro); if (pro < 0) return 0;
    int dbg = int(PRM[109] + 0.5); if (dbg == 1 && pro == 1) pro = 0; if (dbg == 2 && pro != 1) return 0;   // REVA_STRANDSEGDBG: 1 no dense look, 2 only by what stands out
    if (proOnly && pro != 1) return 0;
    float L = length(b - a); int ns = mid; float thr = margin + deepIn;
    if (pro == 1) { ns = clamp(int(L / stp), 2, 16); thr = 0.0; }
    int hits = 0;
    for (int m = 1; m <= ns; m++) { float t = float(m) / float(ns + 1); vec3 q = mix(a, b, t); int pr2;
        float dp = bodyPush(q, margin, n9, pr2); if (dp <= thr) continue; if (pro != 1) dp -= margin;
        float s9 = dp / ((1.0 - t) * (1.0 - t) + t * t); a += n9 * s9 * (1.0 - t); b += n9 * s9 * t;
        hits++; if (dp > depth) { depth = dp; nOut = n9; } }
    return hits;
}
mat4 prmMat(int o) { return mat4(PRM[o], PRM[o + 1], PRM[o + 2], PRM[o + 3], PRM[o + 4], PRM[o + 5], PRM[o + 6], PRM[o + 7], PRM[o + 8], PRM[o + 9], PRM[o + 10], PRM[o + 11], PRM[o + 12], PRM[o + 13], PRM[o + 14], PRM[o + 15]); }
void main() {
